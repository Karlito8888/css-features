---
import Search from "../components/Search.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page does not exist.">
  <section class="container missing">
    <p class="code">404</p>
    <h1>This page does not exist.</h1>
    <p>Search for a feature instead, browse <a href="/modern/">Modern CSS</a>, or go back to the <a href="/">home page</a>.</p>
    <Search large />
  </section>
</Base>

<style>
  .missing { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 5rem 0; }
  .code { margin: 0; font-family: var(--font-mono), monospace; font-size: 1rem; color: var(--accent); font-weight: 600; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); letter-spacing: -0.03em; margin: 0.5rem 0; }
  p { color: var(--muted); }
</style>
