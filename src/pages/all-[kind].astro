---
import ModuleNav from "../components/ModuleNav.astro";
import Base from "../layouts/Base.astro";
import { KINDS, allFeatures, data, featureUrl, type Feature, type Kind } from "../data";

export function getStaticPaths() {
  return (Object.keys(KINDS) as Kind[]).map((kind) => ({
    params: { kind: kind === "at-rule" ? "at-rules" : kind === "property" ? "properties" : `${kind}s` },
    props: { kind },
  }));
}

interface Props {
  kind: Kind;
}

const { kind } = Astro.props;
const moduleOf = new Map(data.modules.flatMap((m) => m.features.map((f) => [f.id, m.title] as const)));
const bare = (f: Feature) => f.name.replace(/^[^a-z]*/i, "").toLowerCase();
const features = allFeatures.filter((f) => f.kind === kind).sort((a, b) => bare(a).localeCompare(bare(b)) || a.name.localeCompare(b.name));
const letter = (f: Feature) => {
  const l = bare(f)[0]?.toUpperCase() ?? "#";
  return /[A-Z]/.test(l) ? l : "#";
};
const letters = [...new Set(features.map(letter))];
const title = `All ${KINDS[kind].plural.toLowerCase()}`;
---

<Base title={title} description={`The ${features.length} CSS ${KINDS[kind].plural.toLowerCase()} defined by the W3C specifications, A to Z, each linking to its definition, browser support and example.`}>
  <div class="container layout">
    <ModuleNav current={null} page={kind} />
    <div>
      <header class="intro">
        <p class="eyebrow">A to Z</p>
        <h1>{title}</h1>
        <p>{features.length} {KINDS[kind].plural.toLowerCase()} across {new Set(features.map((f) => moduleOf.get(f.id))).size} specifications. Dimmed entries are not in any browser yet.</p>
        <nav class="letters" aria-label="Letters">{letters.map((l) => <a href={`#letter-${l === "#" ? "other" : l}`}>{l}</a>)}</nav>
      </header>
      {
        letters.map((l) => (
          <section class="letter" id={`letter-${l === "#" ? "other" : l}`}>
            <h2>{l}</h2>
            <ul>
              {features.filter((f) => letter(f) === l).map((f) => (
                <li class:list={{ draft: !f.compat }}>
                  <a href={featureUrl(f)}><code>{f.name}</code></a>
                  <span>{moduleOf.get(f.id)}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .layout { display: grid; grid-template-columns: 15rem minmax(0, 1fr); gap: 3rem; padding-top: 2rem; }
  @media (max-width: 64rem) {
    .layout { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
  }
  .intro { padding: 1rem 0 1.5rem; }
  .eyebrow { margin: 0; color: var(--accent); font-weight: 700; font-size: 0.85rem; letter-spacing: 0.06em; text-transform: uppercase; }
  h1 { margin: 0.2rem 0 0.75rem; font-size: clamp(2.2rem, 5vw, 3.4rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
  .intro p { color: var(--muted); max-width: 70ch; font-size: 1.05rem; }
  .letters { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .letters a { display: grid; place-items: center; min-width: 2rem; height: 2rem; border-radius: 8px; border: 1px solid var(--border); text-decoration: none; font-weight: 600; font-size: 0.85rem; }
  .letters a:hover { border-color: var(--accent); }
  .letter { padding-top: 1.5rem; scroll-margin-top: calc(var(--header-h) + 1rem); }
  h2 { margin: 0 0 0.5rem; font-size: 1.4rem; color: var(--accent); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); gap: 0.2rem 1rem; }
  li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.3rem 0; border-bottom: 1px solid var(--border); font-size: 0.92rem; }
  li a { text-decoration: none; overflow-wrap: anywhere; }
  li span { color: var(--muted); font-size: 0.8rem; text-align: right; flex-shrink: 0; max-width: 45%; }
  .draft { opacity: 0.6; }
</style>
